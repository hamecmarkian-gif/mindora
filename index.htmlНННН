function start(opts){
 opts=opts||{};
 const mode=REGISTRY.modes.find(m=>m.id===modeId),[lo,hi]=band(save.elo),c=opts.coach;S.tasksPerGame=mode.tasks;
 const mk=()=>{
  if(opts.topic||opts.grade){ // дуель з тренером: тільки обрана тема / клас
   let pool=allTopics().filter(t=>(!opts.topic||t.id===opts.topic)&&(!opts.grade||t.grade===opts.grade));if(!pool.length)pool=allTopics();
   const t=pick(pool);return Object.assign({topic:t.gt,topicName:t.name,lvl:t.L,grade:t.grade},genOf(t.gt)(t.L))}
  const g=rnd(lo,hi),pl=REGISTRY.topics.filter(x=>x.min<=g&&x.min>=g-4),t=pick(pl.length?pl:REGISTRY.topics.filter(x=>x.min<=g));
  return Object.assign({topic:t.id,topicName:t.name,lvl:g,grade:g},t.gen(g))};
 const tasks=Array.from({length:S.tasksPerGame},mk);
 const botElo=Math.max(0,save.elo+(c?c.delta:rnd(-80,80)));
 const botAcc=Math.min(.98,Math.max(.3,.75+(botElo-save.elo)/400+(Math.random()-.5)*.25));
 const botT=Math.round(mode.sec*(.35+Math.random()*.45));
 G={mode,tasks,i:0,res:[],t0:Date.now(),botElo,botAcc:Math.round(botAcc*100)/100,botT,opts,playerEnd:null,hint:{},
  botName:c?c.name:pick(['Олекса','Марічка','Тарас','Соломія','Богдан','Єва']),
  bot:c?{img:c.img,badge:'♟',flag:'🎓',games:999,winp:78,acc:92}:mkBot()};
 view='game';render();clearInterval(tick);tick=setInterval(step,250);
}
const elapsed=()=>(Date.now()-G.t0)/1000;
function deadline(){return Math.min(G.mode.sec,G.botT+S.graceSec)}
function step(){
 if(view!=='game')return;
 const e=elapsed();
 if(e>=deadline()){finish();return}
 const tm=$('#time');tm.textContent='⏱ '+fmt(deadline()-e);tm.classList.toggle('warn',deadline()-e<=10);
 $('#botbar').style.width=Math.min(100,e/G.botT*100)+'%';
 $('#botlab').textContent=e>=G.botT?'закінчив':Math.floor(S.tasksPerGame*e/G.botT)+' / '+S.tasksPerGame;
 const b=$('#ban');if(e>=G.botT&&b){b.hidden=false;b.textContent=`${G.botName} закінчив! У тебе ще ${fmt(deadline()-e)}.`}
}
function render(){
 const t=G.tasks[G.i];
 $('#app').innerHTML=`
 <div class="top"><h2>Задача ${G.i+1} з ${S.tasksPerGame}</h2></div>
 <div class="banner" id="ban" hidden></div>
 <div class="vsbar">
  <div class="timer" id="time" aria-live="off"></div>
  <div class="pl"><button class="lnk pc" data-opp>${botAv(G.bot,'sm2')}<span><b>${esc(G.botName)} <span class="bdg">${G.bot.badge}</span></b><small class="mute">${G.botElo}</small></span></button>
   <div class="bar bot"><i id="botbar" style="width:0"></i></div><span id="botlab" class="mute"></span></div>
  <div class="pl right"><div class="pc">${avatarHTML('sm2')}<span><b>${esc(save.name)} <span class="bdg">${save.badge||'∑'}</span></b><small class="mute">${save.elo}</small></span></div>
   <div class="bar"><i id="mebar" style="width:${G.i/S.tasksPerGame*100}%"></i></div><span class="mute">${G.i} / ${S.tasksPerGame}</span></div>
 </div>
 
<div class="card"><span class="tag" style="background:${tc(t.topic)}">${t.topicName}</span>
  <div class="task">${t.text}</div>
  <input type="text" id="ans" inputmode="decimal" autocomplete="off" aria-label="Відповідь">
  <div class="row"><button class="primary" id="ok">${T('answer')}</button>
   ${t.words&&save.elo>=S.hintMinElo?`<button id="hb">${T('hint')}</button>`:''}</div>
  <div id="hints"></div>
  <details class="padbox" ${save.padOpen?'open':''}><summary>✏️ ${T('pad')}</summary><textarea class="pad" id="pad" rows="7" wrap="off" spellcheck="false"></textarea><div class="row">${['+','−','×','÷','=','──────'].map(c=>`<button data-ins="${c}">${c}</button>`).join('')}<button id="pg" aria-label="+">↕ +</button><button id="pm" aria-label="-">↕ −</button><button id="pc" aria-label="clear">🗑</button></div></details></div>`;
 const inp=$('#ans');inp.focus();
 const go=()=>submit(inp.value);
 $('#ok').onclick=go;inp.onkeydown=e=>{if(e.key==='Enter')go()};
 if($('#hb'))$('#hb').onclick=()=>showHints(t);
 document.querySelectorAll('[data-ins]').forEach(b=>b.onclick=()=>{const pd=$('#pad'),i=pd.selectionStart;pd.setRangeText(b.dataset.ins,i,pd.selectionEnd,'end');pd.focus()});
 bindPad();
 step();
}
function showHints(t){
 G.hint[G.i]=true;const words=[...t.words].sort(()=>Math.random()-.5);
 $('#hints').innerHTML=`<div class="hint"><div class="mute">${T('hintNote')}</div>
  <div class="row">${words.map(w=>`<button data-w="${w}">${w}</button>`).join('')}</div><div id="hmsg"></div></div>`;
 document.querySelectorAll('#hints [data-w]').forEach(b=>b.onclick=()=>{
  if(b.dataset.w===t.key){$('#hmsg').innerHTML=`<b class="good">Так!</b> ${t.hint}`;}
  else{b.disabled=true;$('#hmsg').innerHTML='<span class="badc">Ні, спробуй інше слово.</span>'}});
}
/* бал за відповідь: точна = 1, близька = частковий бал (як “точність 87%”) */
function score(given,ans){
 const g=parseFloat(String(given).replace(',','.').replace('−','-').trim());
 if(isNaN(g))return 0;if(Math.abs(g-ans)<1e-9)return 1;
 const rel=Math.abs(g-ans)/Math.max(1,Math.abs(ans));return Math.max(0,1-3*rel)*.6;
}
function bindPad(){
 const pd=$('#pad'),bx=document.querySelector('.padbox');if(!pd)return;
 if(save.padH)pd.style.height=save.padH+'px';if(save.padW)pd.style.width=save.padW+'px';
 let tm;const keep=()=>{clearTimeout(tm);tm=setTimeout(()=>{if(pd.offsetHeight>0){const full=pd.parentElement.clientWidth;save.padH=pd.offsetHeight;save.padW=Math.abs(pd.offsetWidth-full)>3?pd.offsetWidth:0;persist()}},300)};
 if(window.ResizeObserver)new ResizeObserver(keep).observe(pd);
 const size=d=>{save.padH=Math.max(80,(save.padH||pd.offsetHeight)+d);pd.style.height=save.padH+'px';persist()};
 $('#pg').onclick=()=>size(40);$('#pm').onclick=()=>size(-40);$('#pc').onclick=()=>{pd.value='';pd.focus()};
 bx.ontoggle=()=>{save.padOpen=bx.open;persist()};
}
function submit(v){
 const t=G.tasks[G.i];const s0=score(v,t.answer),hn=!!G.hint[G.i];G.res.push({t,given:v,pts:s0*(hn?.9:1),ok:s0===1,hint:hn});G.i++;
 if(G.i>=S.tasksPerGame){G.playerEnd=elapsed();finish()}else render();
}

/* ============ РЕЗУЛЬТАТ ============ */
function finish(){
 if(view!=='game')return;view='result';clearInterval(tick);
 const end=G.playerEnd??elapsed(),done=G.res.length;
 const pAcc=G.res.reduce((s,r)=>s+r.pts,0)/S.tasksPerGame;
 const f=Math.min(1,(end+S.graceSec)/G.botT);      // скільки суперник встиг
 const bAcc=G.botAcc*f;
 const pa=Math.round(pAcc*100),ba=Math.round(bAcc*100);
 let sc=pa>ba?1:pa<ba?0:(end<=G.botT?1:0);
 if(pa===ba&&end===G.botT)sc=.5;
 const old=save.elo;const rated=!(G.opts&&G.opts.coach);if(rated)save.elo=newElo(old,G.botElo,sc,G.mode.cap);
 if(rated){save.games++;if(sc===1)save.wins++}
 G.res.forEach(r=>{const s=save.stats[r.t.topic]||(save.stats[r.t.topic]={n:0,pts:0});s.n++;s.pts+=r.pts});
 REGISTRY.hooks.afterGame.forEach(fn=>{try{fn({save,G,pa,ba,sc})}catch(e){}});
 save.history=[...G.tasks.map((t,i)=>{const r=G.res[i];return {topic:t.topic,topicName:t.topicName,lvl:t.lvl,text:t.text,answer:t.answer,sol:t.sol||'',given:r?r.given:'',pts:r?r.pts:0,ok:r?r.ok:false,hint:r?r.hint:false}}),...(save.history||[])].slice(0,40);
 persist();
 const d=save.elo-old;
 $('#app').innerHTML=`
 <div class="card"><h1>${sc===1?T('win'):sc===0?T('lose'):T('draw')}</h1>
  <div class="vs"><div><div class="mute">${esc(save.name)}</div><div class="big">${pa}%</div><div class="mute">точність · ${done} з ${S.tasksPerGame} задач · ${fmt(end)}</div></div>
  <div><button class="lnk" data-opp>${botAv(G.bot)} ${G.botName} ${G.bot.badge} ›</button><div class="big">${ba}%</div><div class="mute">точність · Ело ${G.botElo}</div></div></div>
  ${rated?`<p>Рейтинг: ${old} → <b>${save.elo}</b> <span class="${d>=0?'good':'badc'}">(${d>=0?'+':''}${d})</span></p>`:`<p class="mute">${T('unrated')}</p>`}</div>
 <div class="card"><h2>${T('review')}</h2><div class="mute">${T('reviewHint')}</div>${G.tasks.map((t,i)=>{const r=G.res[i],p=r?r.pts:0;return `<details class="lesson"><summary><b>${t.text}</b> <span class="${r&&r.ok?'good':'badc'}">${r?Math.round(p*100)+'%'+(r.hint?' · −10% '+T('hintShort'):''):'—'}</span></summary><div>Твоя: <b>${r&&r.given!==''?esc(r.given):'—'}</b> · Правильно: <b>${t.answer}</b></div><div class="steps"><b>Розв’язання</b><br>${t.sol||'—'}</div></details>`}).join('')}</div>
 <div class="row"><button class="primary" id="again">${T('again')}</button><button id="hm">${T('home')}</button></div>`;
 $('#again').onclick=()=>start(G.opts);$('#hm').onclick=home;
}
home();
</script>
</body>
</html>
