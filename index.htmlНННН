<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Mindora</title>
<link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;600;800&family=Unbounded:wght@600;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#f4f8fb;--surface:#fff;--ink:#12263a;--mute:#5b6f82;--line:#cfdce8;--acc:#1f6feb;--acc-ink:#fff;--pen:#ff9f1c;--ok:#1a9d5c;--bad:#d64045;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:light}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0e1a26;--surface:#162636;--ink:#e7f0f8;--mute:#93a8bb;--line:#2a4056;--acc:#5b9dff;--acc-ink:#0e1a26;--pen:#ffb84d;--ok:#4cc38a;--bad:#ff7b7f;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0e1a26;--surface:#162636;--ink:#e7f0f8;--mute:#93a8bb;--line:#2a4056;--acc:#5b9dff;--acc-ink:#0e1a26;--pen:#ffb84d;--ok:#4cc38a;--bad:#ff7b7f;color-scheme:dark}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 16px/1.5 Onest,system-ui,sans-serif;
background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);background-size:28px 28px;background-attachment:fixed}
main{max-width:760px;margin:0 auto;padding:20px 16px 60px}
h1,h2,h3{font-family:Unbounded,Onest,sans-serif;margin:0 0 .5em;line-height:1.2}
h1{font-size:1.5rem}h2{font-size:1.15rem}h3{font-size:1rem}
.card{background:var(--surface);border:2px solid var(--ink);border-radius:14px;padding:18px;margin-bottom:16px;box-shadow:4px 4px 0 var(--ink)}
.top{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:16px}
.elo{font:800 3rem/1 Unbounded,sans-serif;color:var(--acc)}
.mute{color:var(--mute);font-size:.9rem}
button{font:600 1rem Onest,sans-serif;border:2px solid var(--ink);background:var(--surface);color:var(--ink);border-radius:10px;padding:10px 16px;cursor:pointer}
button:hover{background:var(--line)}
button:focus-visible,input:focus-visible{outline:3px solid var(--pen);outline-offset:2px}
button.primary{background:var(--acc);color:var(--acc-ink)}button.primary:hover{filter:brightness(1.1)}
button.sel{background:var(--pen);color:#12263a}
button:disabled{opacity:.45;cursor:default}
.row{display:flex;flex-wrap:wrap;gap:8px;margin:8px 0 14px}
input[type=text]{font:800 1.6rem Unbounded,sans-serif;width:100%;padding:10px 14px;border:2px solid var(--ink);border-radius:10px;background:var(--bg);color:var(--ink)}
.task{font-size:1.5rem;font-weight:600;margin:10px 0 16px}
.bar{height:12px;border:2px solid var(--ink);border-radius:8px;overflow:hidden;background:var(--bg)}
.bar>i{display:block;height:100%;background:var(--acc);transition:width .3s}
.bar.bot>i{background:var(--pen)}
.lab{display:flex;justify-content:space-between;font-size:.85rem;margin:8px 0 4px}
.timer{font:800 1.4rem Unbounded,sans-serif}
.chip{display:inline-block}
.banner{background:var(--pen);color:#12263a;border-radius:10px;padding:8px 12px;font-weight:600;margin-bottom:12px}
.hint{background:var(--bg);border:2px dashed var(--ink);border-radius:10px;padding:10px;margin-top:12px}
.good{color:var(--ok)}.badc{color:var(--bad)}
.vs{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.big{font:800 2rem Unbounded,sans-serif}
.lesson{border-top:1px solid var(--line);padding:10px 0}
.lesson:first-of-type{border-top:0}
.tag{font-size:.8rem;background:var(--pen);color:#12263a;border-radius:6px;padding:1px 8px;font-weight:600}
.hdr{display:flex;align-items:center;gap:12px;margin-bottom:14px}
.av{width:52px;height:52px;border-radius:50%;border:2px solid var(--ink);object-fit:cover;background:var(--pen);color:#12263a;display:grid;place-items:center;font:800 1.3rem Unbounded,sans-serif;flex:none;overflow:hidden}
.av.lg{width:96px;height:96px;font-size:2.4rem}
.regav{display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:6px}
.chip-elo{margin-left:auto;background:var(--acc);color:var(--acc-ink);border:2px solid var(--ink);border-radius:999px;padding:4px 16px;font:800 1.1rem Unbounded,sans-serif;box-shadow:3px 3px 0 var(--ink)}
.tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;background:var(--surface);border:2px solid var(--ink);border-radius:14px;padding:5px;margin-bottom:16px;position:sticky;top:8px;z-index:5}
.tabs button{border:0;border-radius:10px;background:transparent;padding:10px 4px}
.tabs button.on{background:var(--ink);color:var(--surface)}
.modes{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin:14px 0 16px}
.mode{text-align:left;padding:14px;line-height:1.3}
.mode b{display:block;font-family:Unbounded,sans-serif;font-size:.95rem}
.mode.sel{background:var(--pen);color:#12263a;box-shadow:3px 3px 0 var(--ink)}
button.wide{width:100%;padding:14px;font-size:1.1rem}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.stat{border:2px solid var(--ink);border-radius:12px;padding:10px;text-align:center;background:var(--surface)}
.stat b{display:block;font:800 1.5rem Unbounded,sans-serif;color:var(--acc)}
label.field{display:block;font-weight:600;margin:14px 0 6px}
.lesson.locked{opacity:.55}
.lesson .bar{margin-top:8px;height:8px}
body{background-image:radial-gradient(var(--line) 1.3px,transparent 1.3px);background-size:22px 22px}
.card{border:1.5px solid var(--line);border-radius:20px;padding:20px;box-shadow:0 5px 0 var(--line),0 14px 24px -14px rgba(18,38,58,.3)}
button{border:1.5px solid var(--line);border-radius:12px;box-shadow:0 3px 0 var(--line);transition:transform .08s,box-shadow .08s}
button:active{transform:translateY(3px);box-shadow:none}
button.primary{border-color:transparent;box-shadow:0 4px 0 rgba(0,0,0,.3)}
.tabs{border:1.5px solid var(--line);border-radius:16px;box-shadow:0 10px 20px -10px rgba(18,38,58,.35)}
.tabs button{box-shadow:none}.tabs button:active{transform:none}
.chip-elo{border:0;box-shadow:0 3px 0 rgba(0,0,0,.3)}
.av{border:3px solid var(--acc)}
.who{flex:1;min-width:0}
.bar.thin{height:8px;border-width:1px;margin-top:6px}
.tag{color:#12263a;display:inline-block}
.stat{border:1.5px solid var(--line);border-radius:16px;box-shadow:0 4px 0 var(--line)}
.mode.sel{border-color:var(--pen)}
.seg{display:flex;gap:8px;overflow-x:auto;margin-bottom:14px;padding:2px 2px 8px}
.seg button{white-space:nowrap;border-radius:999px;box-shadow:none;padding:8px 16px}
.seg button.on{background:var(--acc);color:var(--acc-ink);border-color:transparent}
details.sol{padding:0;margin-bottom:12px}
details.sol summary{padding:14px 18px;cursor:pointer;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.solbody{padding:0 18px 18px}.steps{background:var(--bg);border-radius:12px;padding:12px 14px;margin-top:10px;line-height:1.7}
.vgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:14px}
.vcard{margin:0;padding:12px}
.thumb{aspect-ratio:16/9;border-radius:14px;display:grid;place-items:center;font-size:2.4rem;color:#12263a;margin-bottom:10px;position:relative}
.soon,.soon2{font:600 .75rem Onest,sans-serif;background:var(--surface);color:var(--ink);border-radius:999px;padding:2px 10px}
.soon{position:absolute;top:8px;right:8px}.soon2{margin-left:auto}
a.btn{display:inline-block;margin-top:8px;padding:8px 14px;border-radius:10px;background:var(--acc);color:var(--acc-ink);font-weight:600;text-decoration:none}
.empty{text-align:center}
details.lesson summary{cursor:pointer;padding:2px 0}
.coach{display:flex;gap:14px;align-items:center}.ci{font-size:2rem}
.task{font:800 clamp(1.6rem,6vw,2.3rem)/1.3 Unbounded,sans-serif;text-align:center;padding:14px 0}
#ans{text-align:center}
.timer{background:var(--ink);color:var(--surface);border-radius:999px;padding:4px 16px}
.tabs button{padding:10px 2px;font-size:.88rem}
.bdg{display:inline-grid;place-items:center;min-width:1.6em;height:1.6em;padding:0 .3em;border-radius:8px;background:var(--ink);color:var(--surface);font:800 .8em Unbounded,sans-serif;vertical-align:middle}
.av.emo{font-size:2.8rem;background:var(--surface)}
.online{display:flex;align-items:center;gap:8px;font-weight:600;margin-bottom:12px;background:var(--surface);border:1.5px solid var(--line);border-radius:999px;padding:6px 14px;width:fit-content}
.dot{width:10px;height:10px;border-radius:50%;background:var(--ok);box-shadow:0 0 0 4px rgba(26,157,92,.2)}
.pill{border-radius:999px;box-shadow:none;padding:6px 12px;margin:0 4px 4px 0;font-size:.85rem}
.pill.big{padding:8px 14px;font-size:1rem}.pill.on{background:var(--acc);color:var(--acc-ink)}
.search{font:600 1rem Onest,sans-serif;margin-bottom:12px}
button.topic{display:grid;gap:4px;text-align:left;width:100%;margin-bottom:10px;padding:14px 16px;border-radius:16px}
button.lnk{border:0;background:none;box-shadow:none;padding:0;text-decoration:underline;text-underline-offset:3px}
.modal{position:fixed;inset:0;background:rgba(10,20,30,.6);display:grid;place-items:center;padding:16px;z-index:50}
.modal .card{max-width:420px;width:100%;margin:0}
.pad{width:100%;font:600 1.5rem/1.6 ui-monospace,Menlo,monospace;letter-spacing:.35em;border:1.5px solid var(--line);border-radius:12px;background:var(--bg);color:var(--ink);background-image:linear-gradient(90deg,var(--line) 1px,transparent 1px);background-size:calc(1ch + .35em) 100%;padding:8px}
.pin{width:140px;font-size:1.1rem;padding:8px}
details.padbox{margin-top:12px}details.padbox summary{cursor:pointer;font-weight:600}
.av.sm{width:26px;height:26px;border-width:2px;vertical-align:middle}
.cline{display:flex;gap:12px;align-items:flex-start;margin:8px 0}
.cav{width:56px;height:56px;flex:none}
.bub{background:var(--bg);border:1.5px solid var(--line);border-radius:4px 16px 16px 16px;padding:10px 14px}
.coaches{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:14px}
button.ccard{display:grid;gap:4px;justify-items:center;padding:10px 6px;text-align:center;border-radius:16px;font-size:.8rem}
button.ccard b{font-size:1rem}
button.ccard img{width:72px;height:72px;border-radius:50%;object-fit:cover;border:3px solid var(--line)}
button.ccard.on{background:var(--pen);color:#12263a}button.ccard.on img{border-color:var(--ink)}
.vsbar{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px}
.vsbar .timer{grid-column:1/-1;justify-self:center;font-size:2rem;padding:6px 28px}
.timer.warn{background:var(--bad);color:#fff;animation:pulse 1s infinite}
@keyframes pulse{50%{opacity:.7}}
.pl{background:var(--surface);border:1.5px solid var(--line);border-radius:16px;padding:10px;display:grid;gap:6px;box-shadow:0 4px 0 var(--line);align-content:start;min-width:0}
.pl.right{text-align:right}
.pl .pc{display:flex;align-items:center;gap:8px;min-width:0}
.pl.right .pc{flex-direction:row-reverse}
.pl .pc>span{display:grid;line-height:1.25;min-width:0;overflow-wrap:anywhere}
.pl .lnk{text-decoration:none;text-align:left;color:inherit}
.av.sm2{width:40px;height:40px;border-width:2px;flex:none;font-size:1rem}
.av.sm2.emo{font-size:1.4rem}.av.sm.emo{font-size:.9rem}
.pad{text-align:right;letter-spacing:.12em;line-height:1.6;background-image:linear-gradient(var(--line) 1px,transparent 1px);background-size:100% 1.6em;background-position:0 8px;background-attachment:local;resize:both;max-width:100%;min-height:80px;overflow:auto;white-space:pre}
.doneb{background:var(--ok);color:#fff;border-radius:10px;padding:8px 12px;font-weight:700;margin-bottom:10px}
.toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:var(--surface);padding:10px 18px;border-radius:999px;font-weight:700;z-index:60}
.agrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
.ach{display:grid;gap:4px;border:1.5px solid var(--line);border-radius:14px;padding:12px;background:var(--bg)}
.ach.off{opacity:.45;filter:grayscale(1)}.ach .ai{font-size:1.8rem}
.brand{font:800 1.35rem Unbounded,sans-serif;color:var(--acc);letter-spacing:.02em;margin-bottom:12px}
@media (prefers-reduced-motion:reduce){.bar>i{transition:none}}
</style>
</head>
<body>
<main id="app"></main>
<script>
/* ============ РЕЄСТР: тут додається все нове ============
   Нова тема задач  -> REGISTRY.topics.push({...})
   Новий режим      -> REGISTRY.modes.push({...})
   Новий “плагін”   -> REGISTRY.hooks.afterGame.push(fn)   (досягнення, бейджі, щоденні задачі…)
*/
const rnd=(a,b)=>Math.floor(Math.random()*(b-a+1))+a;
const pick=a=>a[rnd(0,a.length-1)];
const gcd=(a,b)=>b?gcd(b,a%b):a;
const P=n=>n<0?`(${n})`:`${n}`;
const REGISTRY={
 settings:{startElo:100,K:40,hintMinElo:200,graceSec:10,tasksPerGame:5,lessonsAfterGames:3,weakBelow:0.7},
 modes:[
  {id:'demo',name:'Швидка · 2 хв',sec:120,tasks:1,cap:5},
  {id:'blitz',name:'Бліц · 10 хв',sec:600,tasks:5,cap:15},
  {id:'std',name:'Класика · 30 хв',sec:1800,tasks:15,cap:30}
 ],
 topics:[
  {id:'add',name:'Додавання і віднімання',min:1,
   lesson:'Розбивай числа на розряди: 47 + 38 = 47 + 30 + 8 = 85. Віднімання перевіряй додаванням.',
   gen(L){const a=rnd(10,20+25*L),b=rnd(10,20+25*L);const ta=Math.floor(a/10)*10,tb=Math.floor(b/10)*10;return Math.random()<.5?{text:`${a} + ${b} = ?`,answer:a+b,sol:`Спочатку десятки: ${ta} + ${tb} = ${ta+tb}.<br>Потім одиниці: ${a-ta} + ${b-tb} = ${a-ta+b-tb}.<br>Разом: ${ta+tb} + ${a-ta+b-tb} = <b>${a+b}</b>.`}:{text:`${a+b} − ${b} = ?`,answer:a,sol:`Віднімання перевіряємо додаванням: яке число разом з ${b} дає ${a+b}?<br>${a} + ${b} = ${a+b}, тож відповідь <b>${a}</b>.`}}},
  {id:'mul',name:'Множення',min:1,
   lesson:'Таблиця множення + розклад: 14 × 6 = 10×6 + 4×6 = 60 + 24 = 84.',
   gen(L){const a=rnd(2,5+L),b=rnd(2,6+L);const h=Math.floor(b/2);return {text:`${a} × ${b} = ?`,answer:a*b,sol:`Розбий ${b} на ${h} і ${b-h}.<br>${a} × ${h} = ${a*h}, ${a} × ${b-h} = ${a*(b-h)}.<br>Разом: ${a*h} + ${a*(b-h)} = <b>${a*b}</b>.`}}},
  {id:'eq',name:'Рівняння',min:2,
   lesson:'Щоб знайти невідоме, зроби обернену дію: x + 7 = 20 → x = 20 − 7. Якщо є коефіцієнт — поділи обидві частини.',
   gen(L){if(L<4){const x=rnd(2,10*L),a=rnd(2,10*L);return {text:`x + ${a} = ${x+a}.  x = ?`,answer:x,sol:`Щоб знайти x, віднімаємо ${a} від обох частин.<br>x = ${x+a} − ${a} = <b>${x}</b>.`}}
    const x=rnd(2,6+L),a=rnd(2,9),b=rnd(1,20);return {text:`${a}x + ${b} = ${a*x+b}.  x = ?`,answer:x,sol:`Віднімаємо ${b}: ${a}x = ${a*x+b} − ${b} = ${a*x}.<br>Ділимо на ${a}: x = ${a*x} ÷ ${a} = <b>${x}</b>.`}}},
  {id:'geo',name:'Геометрія',min:2,
   lesson:'Площа прямокутника = a × b (кількість квадратиків всередині). Периметр = 2 × (a + b) (довжина обходу навколо).',
   gen(L){const a=rnd(2,4+2*L),b=rnd(2,4+2*L);const area=Math.random()<.5;
    return {text:`Прямокутник ${a} см × ${b} см. Знайди ${area?'площу':'периметр'} (число).`,answer:area?a*b:2*(a+b),sol:area?`Площа S = a × b.<br>S = ${a} × ${b} = <b>${a*b}</b> см².`:`Периметр P = 2 × (a + b).<br>P = 2 × (${a} + ${b}) = 2 × ${a+b} = <b>${2*(a+b)}</b> см.`,
     words:['площа','периметр','об’єм'],key:area?'площа':'периметр',
     hint:area?'Площа = a × b':'Периметр = 2 × (a + b)'}}},
  {id:'pct',name:'Відсотки',min:4,
   lesson:'10% — це поділити на 10; 50% — на 2; 25% — на 4. Інші відсотки складай з цих.',
   gen(L){const p=pick([10,20,25,50,75]),n=rnd(2,8+L)*20;return {text:`${p}% від ${n} = ?`,answer:n*p/100,sol:`${p}% — це ${p}/100.<br>${n} × ${p} ÷ 100 = <b>${n*p/100}</b>.`,
     words:['частка','добуток сум','відсоток від числа'],key:'відсоток від числа',hint:'p% від n = n × p ÷ 100'}}},
  {id:'pow',name:'Степені й корені',min:5,
   lesson:'a² = a × a. Корінь — обернена дія: √49 = 7, бо 7² = 49.',
   gen(L){const a=rnd(2,6+L);return Math.random()<.5?{text:`${a}² = ?`,answer:a*a,sol:`${a}² = ${a} × ${a} = <b>${a*a}</b>.`}:{text:`√${a*a} = ?`,answer:a,sol:`Яке число в квадраті дає ${a*a}? ${a} × ${a} = ${a*a}, тож <b>${a}</b>.`}}},
  {id:'dec',name:'Десяткові дроби',min:5,
   lesson:'Записуй числа в стовпчик так, щоб кома стояла під комою.',
   gen(L){const a=rnd(11,99)/10,b=rnd(11,99)/10,r=Math.round((a+b)*10)/10;return {text:`${a} + ${b} = ?`,answer:r,sol:`Кома під комою: ${a} + ${b} = <b>${r}</b>.`}}},
  {id:'quad',name:'Квадратні рівняння',min:8,
   lesson:'За теоремою Вієта: x₁ + x₂ = −b, x₁ · x₂ = c.',
   gen(L){const a=rnd(1,9),b=rnd(1,9);return {text:`x² − ${a+b}x + ${a*b} = 0. Знайди більший корінь.`,answer:Math.max(a,b),sol:`За Вієтом: x₁ + x₂ = ${a+b}, x₁ · x₂ = ${a*b}.<br>Підходять ${a} і ${b}. Більший корінь: <b>${Math.max(a,b)}</b>.`}}},
  {id:'div',name:'Ділення',min:2,lesson:'Ділення — обернена дія до множення: 24 ÷ 6 = 4, бо 6 × 4 = 24.',
   gen(L){const b=rnd(2,5+L),r=rnd(2,6+L),a=b*r;return {text:`${a} ÷ ${b} = ?`,answer:r,sol:`Яке число, помножене на ${b}, дає ${a}? ${b} × ${r} = ${a}, тож <b>${r}</b>.`}}},
  {id:'ord',name:'Порядок дій',min:3,lesson:'Спочатку дужки, потім множення й ділення, потім додавання й віднімання.',
   gen(L){const a=rnd(2,6+L),b=rnd(2,6+L),c=rnd(2,9+L);return Math.random()<.5?{text:`${a} + ${b} × ${c} = ?`,answer:a+b*c,sol:`Спершу множення: ${b} × ${c} = ${b*c}.<br>Потім додавання: ${a} + ${b*c} = <b>${a+b*c}</b>.`}:{text:`(${a} + ${b}) × ${c} = ?`,answer:(a+b)*c,sol:`Спершу дужки: ${a} + ${b} = ${a+b}.<br>Потім множення: ${a+b} × ${c} = <b>${(a+b)*c}</b>.`}}},
  {id:'unit',name:'Одиниці вимірювання',min:2,lesson:'1 м = 100 см, 1 км = 1000 м, 1 год = 60 хв, 1 кг = 1000 г.',
   gen(L){const k=rnd(2,9+L),t=pick([['м','см',100],['км','м',1000],['год','хв',60],['кг','г',1000]]);return {text:`${k} ${t[0]} = ? ${t[1]}`,answer:k*t[2],sol:`1 ${t[0]} = ${t[2]} ${t[1]}.<br>${k} × ${t[2]} = <b>${k*t[2]}</b> ${t[1]}.`}}},
