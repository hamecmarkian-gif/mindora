const S=REGISTRY.settings;

/* ============ СТАН ============ */
const KEY='mathduel_v1';
let save={elo:S.startElo,games:0,wins:0,stats:{},name:'',avatar:'',badge:'∑',lang:'uk',vlang:'uk'};
try{const r=localStorage.getItem(KEY);if(r)save=Object.assign(save,JSON.parse(r))}catch(e){}
const persist=()=>{try{localStorage.setItem(KEY,JSON.stringify(save))}catch(e){}};
let modeId='demo',view='home',G=null,tick=null;
const $=s=>document.querySelector(s);
const level=elo=>Math.max(1,Math.floor(elo/100)+1);
const fmt=s=>{s=Math.max(0,Math.ceil(s));return Math.floor(s/60)+':'+String(s%60).padStart(2,'0')};

/* ============ ЕЛО ============ */
const expected=(me,opp)=>1/(1+Math.pow(10,(opp-me)/400));
const newElo=(me,opp,score,cap)=>Math.max(0,me+Math.max(-cap,Math.min(cap,Math.round(1.5*cap*(score-expected(me,opp))))));

/* ============ ПРОФІЛЬ ============ */
let tab='game';
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const avatarHTML=(cls='')=>save.avatar?`<img class="av ${cls}" src="${save.avatar}" alt="Аватарка">`:`<div class="av ${cls}">${esc((save.name||'?')[0].toUpperCase())}</div>`;
function pickAvatar(cb){ // відкриває галерею, кадрує до квадрата 160×160
 const f=document.createElement('input');f.type='file';f.accept='image/*';
 f.onchange=()=>{const file=f.files[0];if(!file)return;const rd=new FileReader();
  rd.onload=()=>{const img=new Image();img.onload=()=>{const c=document.createElement('canvas');c.width=c.height=160;const s=Math.min(img.width,img.height);
   c.getContext('2d').drawImage(img,(img.width-s)/2,(img.height-s)/2,s,s,0,0,160,160);cb(c.toDataURL('image/jpeg',.82))};img.src=rd.result};rd.readAsDataURL(file)};
 f.click();
}
const topicAcc=t=>{const s=save.stats[t.id];return s&&s.n?Math.round(s.pts/s.n*100):null};

function register(){
 view='home';
 $('#app').innerHTML=`<div class="card"><div class="brand">Mindora</div><h1>Ласкаво просимо!</h1>
 <p class="mute">Створи профіль. Він зберігається на цьому пристрої.</p>
 <div class="regav"><span id="avbox">${avatarHTML('lg')}</span><button id="pa">Обрати фото з галереї</button></div>
 <label class="field" for="nm">Ім’я</label>
 <input type="text" id="nm" maxlength="20" placeholder="Як тебе звати?" value="${esc(save.name)}">
 <div id="err" class="badc"></div>
 <div class="row"><button class="primary" id="reg">Почати грати</button></div></div>`;
 $('#pa').onclick=()=>pickAvatar(d=>{save.avatar=d;$('#avbox').innerHTML=avatarHTML('lg')});
 const go=()=>{const n=$('#nm').value.trim();if(n.length<2){$('#err').textContent='Ім’я має містити щонайменше 2 символи.';return}
  save.name=n;persist();tab='game';home()};
 $('#reg').onclick=go;$('#nm').onkeydown=e=>{if(e.key==='Enter')go()};
}

