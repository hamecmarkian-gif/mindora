rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Повний прогрес гравця (синхронізація між пристроями) — тільки власник.
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Публічний профіль: його бачать усі авторизовані (так працює пошук друга за кодом),
    // змінювати може тільки власник.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name','elo','badge','title','photo','code','games','wins','streak','done','ach','badges','titles'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.code is string && request.resource.data.code.size() <= 12
        && request.resource.data.elo is number;
      allow delete: if false;
    }

    // «Онлайн»: свій запис пише тільки власник.
    match /presence/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['ts'])
        && request.resource.data.ts is number;
      allow delete: if false;
    }

    // Коди друзів (6 цифр): зайняти код можна один раз і тільки на свій uid.
    match /ids/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Дуелі: бачать і змінюють лише двоє учасників.
    match /duels/{id} {
      allow read: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && !('to' in request.resource.data.res);

      // Умови (хто, з ким, задачі) незмінні; кожен учасник змінює лише СВІЙ результат.
      allow update: if signedIn()
        && resource.data.from == request.resource.data.from
        && resource.data.to == request.resource.data.to
        && resource.data.seed == request.resource.data.seed
        && resource.data.cfg == request.resource.data.cfg
        && (
          (request.auth.uid == resource.data.from
            && request.resource.data.res.get('to', null) == resource.data.res.get('to', null))
          ||
          (request.auth.uid == resource.data.to
            && request.resource.data.res.get('from', null) == resource.data.res.get('from', null))
        );

      allow delete: if false;
    }

    // Усе інше — заборонено.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
